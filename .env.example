# ============================================================
# 共享中间件 infra 环境变量模板
# 使用方法：cp .env.example .env 后按需填写
# 安全约定：所有密码只写在 .env（已被 .gitignore 排除），
#           本仓库代码/脚本/配置不保存任何真实或默认凭据。
# MySQL 账号密码由 docker-compose 注入容器，
#           由 init/mysql/01-create-databases.sh 执行建库建账号。
# ============================================================

# ---- MySQL root（仅 infra 自用）----
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ---- 各 agent 库账号密码（用户名可保留，密码务必修改）----
MYSQL_CONTRACT_USER=contract
MYSQL_CONTRACT_PASSWORD=CHANGE_ME
MYSQL_RAG_USER=native_rag_user
MYSQL_RAG_PASSWORD=CHANGE_ME
MYSQL_CS_USER=csuser
MYSQL_CS_PASSWORD=CHANGE_ME
MYSQL_EVAL_USER=evaluation
MYSQL_EVAL_PASSWORD=CHANGE_ME
MYSQL_EVAL_MIGRATE_USER=evaluation_migrate
MYSQL_EVAL_MIGRATE_PASSWORD=CHANGE_ME
MYSQL_SP_USER=smart
MYSQL_SP_PASSWORD=CHANGE_ME

# ---- Neo4j（对外认证密码）----
NEO4J_PASSWORD=CHANGE_ME

# ---- MinIO（milvus 对象存储 + sp 标书存储）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---- 宿主端口（可保持默认）----
MYSQL_PORT=33061
REDIS_PORT=36379
NEO4J_HTTP_PORT=37474
NEO4J_BOLT_PORT=37687
MINIO_API_PORT=39000
MINIO_CONSOLE_PORT=39001
MILVUS_PORT=39530
MILVUS_METRIC_PORT=39091
BGE_M3_PORT=38081
ATTU_PORT=38000

# ---- Elasticsearch（online 观测存储，IK 自构建 docker/es）----
ES_HTTP_PORT=39200

# ---- Kafka（online 事件通道，KRaft 单节点 dev 无鉴权）----
KAFKA_PORT=39092
